# URL del proyecto Supabase (pública)
NEXT_PUBLIC_SUPABASE_URL=
# Clave publishable (o anon) de Supabase: solo lectura y Realtime (pública)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Clave secret (o service_role) de Supabase: todas las escrituras. SECRETA, solo servidor
SUPABASE_SECRET_KEY=

# Proveedor del LLM: gemini | mock (mock = sin clave ni cuota; repuesto si se agota la de Gemini)
LLM_PROVIDER=gemini
# ID exacto del modelo (copiar de Google AI Studio). Recomendado: gemini-3.5-flash-lite.
# Plan gratuito: solo los «flash-lite» tienen 500 peticiones/día y 15/min; los Flash grandes
# (p. ej. gemini-3.5-flash) solo 20/día y 5/min, y se agotan en un par de runs.
LLM_MODEL=
# Clave de la API de Gemini (aistudio.google.com, gratis, sin tarjeta). SECRETA
GEMINI_API_KEY=

# Sal aleatoria para hashear las IPs (protección de cuota). SECRETA
IP_HASH_SALT=
# Máximo de runs por hora en total (protege la cuota gratuita del LLM)
MAX_RUNS_PER_HOUR=5
# Máximo de runs por hora y por IP
MAX_RUNS_PER_IP_PER_HOUR=3
# Código de acceso a la demo (opcional; si se deja vacío, no se pide). SECRETA
DEMO_ACCESS_CODE=
